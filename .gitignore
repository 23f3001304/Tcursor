# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
target/

# docs-hover VS Code extension build output (node_modules already ignored above)
tools/docs-hover/out/
tools/docs-hover/*.vsix

# Bundled ffmpeg/ffprobe (large static binaries; copied locally, bundled into the installer)
src-tauri/resources/*.exe

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Raw asset-generator outputs (tools/assetgen): 1024px sprites, contact sheets and probes are
# regenerated on demand; only the built packs under src-tauri/assets are part of the repository.
tools/assetgen/packs/
tools/assetgen/*_sheet.png
tools/assetgen/probe_*.png

# Python bytecode from the asset generator
__pycache__/

# agent worktrees for parallel feature tracks
.worktrees/
