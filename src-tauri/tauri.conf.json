{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCursor",
  "version": "0.1.0",
  "identifier": "com.coehe.tcursor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TCursor",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream",
        "dragDropEnabled": false,
        "width": 860,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": { "requireLiteralLeadingDot": false, "allow": ["$HOME/**", "$VIDEO/**", "$DESKTOP/**", "$DOCUMENT/**", "$DOWNLOAD/**", "**/*"] }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Coehe",
    "copyright": "Copyright © 2026 Coehe",
    "category": "Productivity",
    "shortDescription": "Auto-zoom screen recorder",
    "longDescription": "TCursor turns raw screen captures into polished, intentional-looking demos — automatic cursor-follow zooms, a built-in editor, and an AI director.",
    "licenseFile": "installer/eula.rtf",
    "resources": ["resources/ffmpeg.exe", "resources/ffprobe.exe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["tcursor"],
        "name": "TCursor Project",
        "description": "TCursor project",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "displayLanguageSelector": false,
        "languages": ["English"]
      },
      "wix": {
        "bannerPath": "installer/banner.bmp",
        "dialogImagePath": "installer/dialog.bmp"
      }
    }
  }
}
